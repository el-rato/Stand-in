{
  "openapi": "3.0.3",
  "info": { "title": "STANDIN API", "version": "0.1.0", "description": "Humans-on-demand marketplace: jobs, escrow, payouts, realtime feed." },
  "servers": [{ "url": "http://localhost:3001" }],
  "paths": {
    "/health": { "get": { "summary": "Liveness probe" } },
    "/api/v1/auth/register": { "post": { "summary": "Register with email + password" } },
    "/api/v1/auth/login": { "post": { "summary": "Login, receive JWT" } },
    "/api/v1/auth/password": { "post": { "summary": "Change password (proves current)" } },
    "/api/v1/jobs/feed": { "get": { "summary": "Public live feed (cursor paginated)" } },
    "/api/v1/jobs/mine": { "get": { "summary": "My jobs as asker or doer" } },
    "/api/v1/jobs/{id}": { "get": { "summary": "Job detail + escrow ledger" } },
    "/api/v1/jobs": { "post": { "summary": "Post a job (server prices it, escrow held)" } },
    "/api/v1/jobs/{id}/claim": { "post": { "summary": "Verified doer claims an open job" } },
    "/api/v1/jobs/{id}/deliver": { "post": { "summary": "Doer attaches finished video" } },
    "/api/v1/jobs/{id}/approve": { "post": { "summary": "Asker releases 80% payout" } },
    "/api/v1/jobs/{id}/cancel": { "post": { "summary": "Asker cancels + refunds escrow" } },
    "/api/v1/doers/profile": { "post": { "summary": "Create doer profile" } },
    "/api/v1/doers/verify": { "post": { "summary": "Complete verification" } },
    "/api/v1/doers/me": { "get": { "summary": "My doer status" } },
    "/api/v1/billing/plus/checkout": { "post": { "summary": "Subscribe to Standin+ (demo or Stripe)" } },
    "/api/v1/billing/webhook": { "post": { "summary": "Stripe webhook (raw body)" } },
    "/api/v1/billing/sales": { "post": { "summary": "Request business API demo" } },
    "/api/v1/business/keys": {
      "get": { "summary": "List B2B API keys" },
      "post": { "summary": "Create B2B API key (raw shown once)" }
    },
    "/api/v1/admin/overview": { "get": { "summary": "Owner stats (admin only)" } },
    "/api/v1/admin/jobs": { "get": { "summary": "All jobs, any status (admin only)" } },
    "/api/v1/admin/jobs/{id}/cancel": { "post": { "summary": "Moderate: refund open / reopen claimed (admin only)" } },
    "/api/v1/admin/users": { "get": { "summary": "Search users (admin only)" } },
    "/api/v1/admin/users/{id}/role": { "post": { "summary": "Grant/revoke admin (admin only)" } },
    "/api/v1/admin/ledger": { "get": { "summary": "Recent money trail (admin only)" } },
    "/api/v1/admin/export": { "get": { "summary": "Full snapshot download (admin only)" } },
    "/api/v1/reports": { "post": { "summary": "File a safety report or contact message" } },
    "/api/v1/admin/reports": { "get": { "summary": "Read the inbox (admin only)" } },
    "/api/v1/doers/connect": { "post": { "summary": "Start Stripe Connect onboarding (or demo)" } },
    "/api/v1/doers/connect/status": { "get": { "summary": "Payout connection status" } },
    "/api/v1/payouts/mine": { "get": { "summary": "My payouts + available balance" } },
    "/api/v1/payouts/request": { "post": { "summary": "Cash out balance (transfer or queued)" } },
    "/api/v1/admin/payouts": { "get": { "summary": "All payouts (admin only)" } },
    "/api/v1/uploads/presign": { "post": { "summary": "Get upload + public URLs" } },
    "/api/v1/stream": { "get": { "summary": "Live marketplace events (SSE)" } },
    "/api/v1/metrics/summary": { "get": { "summary": "Paid-today + open jobs" } }
  }
}
