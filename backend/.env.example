# ---- core ----
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=7d

# ---- storage ----
# Leave empty for zero-dependency local demo (JSON file store).
# Set to a postgres URL to run the scalable store (needs `npm i pg`).
DATABASE_URL=
DATA_FILE=./data/db.json

# ---- scale-out (optional, all degrade gracefully when unset) ----
REDIS_URL=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
ADMIN_EMAILS=owner@example.com
FRONTEND_ORIGIN=http://localhost:5500
