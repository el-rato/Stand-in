{
  "name": "standin-api",
  "version": "0.1.0",
  "description": "Scalable backend for STANDIN — humans-on-demand marketplace (jobs, escrow, payouts, realtime feed).",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/api.test.js",
    "syntax": "node scripts/check-syntax.js",
    "check": "npm run syntax && npm test",
    "sql": "node scripts/apply-sql.js",
    "check:production": "node scripts/check-production.js",
    "seed": "node seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nanoid": "^5.0.8",
    "pg": "^8.23.0",
    "qs": "^6.16.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^5.8.2",
    "stripe": "^22.6.2",
    "zod": "^3.23.8"
  }
}
